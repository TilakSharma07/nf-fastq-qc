/*
 * Minimal test profile: runs end-to-end on the bundled synthetic FASTQs
 * in under a minute on a laptop.
 *
 *   nextflow run . -profile test --outdir results_test
 */

params {
    input          = "${projectDir}/test-data/samplesheet.csv"
    quality_cutoff = 25
    min_length     = 25
    min_q30_after  = 70.0
    max_cpus       = 2
    max_memory     = '2.GB'
}
