manifest {
    name            = 'nf-fastq-qc'
    author          = 'Tilak Sharma'
    description     = 'Reproducible FASTQ QC and trimming with a hard validation gate'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

params {
    input          = null
    outdir         = 'results'
    help           = false

    // Trimming
    quality_cutoff = 20
    min_length     = 25
    adapter        = 'AGATCGGAAGAGC'   // Illumina TruSeq universal adapter

    // Validation gate
    min_q30_after  = 70.0
}

// bin/ on PYTHONPATH so fq_trim can import fq_qc.
env {
    PYTHONPATH = "${projectDir}/bin"
}

process {
    errorStrategy = 'terminate'

    withLabel: process_single {
        cpus   = 1
        memory = '2.GB'
        time   = '1.h'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process {
            container = 'python:3.11-slim'
            withName: 'PLOT_QC' {
                container = 'quay.io/biocontainers/matplotlib:3.7.1'
            }
        }
    }
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }
    test {
        includeConfig 'conf/test.config'
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html" }
